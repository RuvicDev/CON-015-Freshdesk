{
  "id": "freshdesk",
  "name": "Freshdesk",
  "name_en": "Freshdesk",
  "version": "1.0.0",
  "description": "Gestión de tickets en Freshdesk: crear ticket, actualizar ticket, agregar nota y consultar por ID",
  "description_en": "Freshdesk ticket management: create ticket, update ticket, add note and retrieve by ID",
  "category": "ITSM / Ticketing",
  "category_en": "ITSM / Ticketing",
  "keywords": ["freshdesk", "ticket", "tickets", "soporte", "itsm", "helpdesk"],
  "icon": "icon.svg",
  "library": {"package": "ruvic-freshdesk-connector", "install": "pip install git+https://github.com/tu-org/conector-freshdesk.git#subdirectory=lib", "import_name": "ruvic_freshdesk_connector"},
  "auth_modes": [{"id": "api_key", "label": "API Key", "fields": [
    {"key": "domain", "label": "Dominio Freshdesk", "type": "text", "required": true, "placeholder": "miempresa o miempresa.freshdesk.com"},
    {"key": "api_key", "label": "API Key", "type": "password", "secret": true, "required": true},
    {"key": "verify_ssl", "label": "Verificar SSL", "type": "boolean", "required": false, "default": "true"},
    {"key": "timeout", "label": "Timeout (segundos)", "type": "number", "required": false, "default": "20"},
    {"key": "max_results", "label": "Máximo resultados", "type": "number", "required": false, "default": "100"}
  ]}],
  "env_prefix": "RUVIC_FRESHDESK_",
  "operations": ["ticket.create_ticket", "ticket.update_ticket", "ticket.add_note", "ticket.get_ticket"],
  "test_connection": true,
  "docs": {"skill": "SKILL.md", "permissions_note": "La API key debe pertenecer a un agente Freshdesk con permisos para crear, actualizar, consultar tickets y agregar notas."}
}
